{
  "name": "kashi-monorepo",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check:tokens": "node packages/tokens/check-tokens.mjs",
    "check:skills": "bash scripts/validate.sh",
    "check": "pnpm run build && pnpm run typecheck && pnpm run check:tokens && pnpm run check:skills",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^7.0.2"
  }
}
