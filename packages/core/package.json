{
  "name": "@softwareseva/core",
  "version": "0.1.0",
  "description": "Shared foundation for kashi apps: Hono app factory with request ids and error envelope, ApiError, WebCrypto helpers, PBKDF2 passwords, sortable ids, phone normalisation, LIKE escaping, D1 rate limiting, and a fetch client with shared session refresh.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/softwareseva/kashi", "directory": "packages/core" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "migrations", "secrets.json", "README.md"],
  "exports": {
    "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.13.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": true }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.13.9",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.0"
  }
}
