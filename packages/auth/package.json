{
  "name": "@softwareseva/auth",
  "version": "1.0.0",
  "description": "Drop-in authentication for Hono on Cloudflare Workers + D1 and React: JWT access tokens with rotating refresh-token families, cookie or bearer transport, password, WhatsApp/SMS/email one-time codes, Google, Sign in with Apple, and passkeys (WebAuthn). Ships its migrations, a secrets manifest, and React sign-in components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/softwareseva/kashi",
    "directory": "packages/auth"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations",
    "secrets.json",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@softwareseva/core": "workspace:^"
  },
  "peerDependencies": {
    "@softwareseva/ui": "workspace:^",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.13.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@softwareseva/ui": {
      "optional": true
    },
    "@simplewebauthn/browser": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@softwareseva/ui": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/react": "^19.0.0",
    "hono": "^4.13.9",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.0"
  }
}
