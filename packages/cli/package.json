{
  "name": "@softwareseva/cli",
  "version": "1.6.0",
  "description": "kashi command line: init a project, copy package migrations, print the secrets checklist, check gitignore and secrets, update every @softwareseva package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/softwareseva/kashi",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "kashi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "secrets.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
