{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kashi secrets manifest",
  "type": "object",
  "required": ["package", "secrets"],
  "properties": {
    "package": { "type": "string" },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "generate", "store"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "usedBy": { "type": "string", "description": "Feature or subpath that reads it" },
          "description": { "type": "string" },
          "generate": { "type": "string", "description": "One-line summary of how to obtain or generate the value" },
          "store": { "type": "array", "items": { "enum": ["wrangler-secret", "dev-vars", "ci-secret", "env", "match", "keychain"] } },
          "rotate": { "type": "string" },
          "optional": { "type": "boolean" },
          "when": { "type": "string", "description": "Only needed when this feature is enabled" },
          "gitignore": { "type": "array", "items": { "type": "string" } },
          "docs": { "type": "string", "description": "Path (optionally with a #anchor) to this secret's step-by-step walkthrough in the package's own SECRETS.md, e.g. \"SECRETS.md#google_client_id\"" }
        }
      }
    }
  }
}
