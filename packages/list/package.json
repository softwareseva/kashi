{
  "name": "@kashi/list",
  "version": "0.1.0",
  "description": "Paginated, searchable, sortable lists for Cloudflare D1: two-way keyset cursors on (sort_value, id), allowlisted sort keys, escaped LIKE search, an offset variant for small admin lists, and the zod list-query contract shared with clients.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/softwareseva/kashi", "directory": "packages/list" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kashi/core": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.0"
  }
}
