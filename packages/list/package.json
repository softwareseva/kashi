{
  "name": "@softwareseva/list",
  "version": "1.0.0",
  "description": "Paginated, searchable, sortable lists for Cloudflare D1 and React: two-way keyset cursors on (sort_value, id), allowlisted sort keys, escaped LIKE search, an offset variant, the shared list-query contract, and a token-styled DataTable with URL-backed directory state.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/softwareseva/kashi",
    "directory": "packages/list"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@softwareseva/core": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "@softwareseva/ui": "workspace:^",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "react": "^19.0.0",
    "lucide-react": ">=0.500.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.0",
    "@softwareseva/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "lucide-react": "^0.500.0"
  },
  "peerDependenciesMeta": {
    "@softwareseva/ui": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  }
}
