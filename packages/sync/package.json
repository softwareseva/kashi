{
  "name": "@softwareseva/sync",
  "version": "0.2.0",
  "description": "Offline-first sync for Hono on Cloudflare Workers + D1: idempotent batched push of client operations with replay, and a change log with a monotonic cursor for pulling upserts and deletes per scope. Pairs with the kashi_sync Flutter package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/softwareseva/kashi",
    "directory": "packages/sync"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations",
    "secrets.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@softwareseva/core": "workspace:^"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "zod": "^4.0.0",
    "rxdb": "^17.0.0",
    "rxjs": "^7.8.0",
    "@tanstack/db": "^0.9.0",
    "@tanstack/react-db": "^0.4.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "rxdb": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@tanstack/db": {
      "optional": true
    },
    "@tanstack/react-db": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "hono": "^4.13.9",
    "rxdb": "^17.0.0",
    "rxjs": "^7.8.0",
    "@tanstack/db": "^0.9.0",
    "@tanstack/react-db": "^0.4.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.0"
  }
}
