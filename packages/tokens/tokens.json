{
  "$schema": "./tokens.schema.json",
  "name": "kaushik",
  "description": "Default kashi theme. Warm paper surfaces, saffron brand, terracotta links.",
  "color": {
    "light": {
      "surface": "#fbf7f0", "surface-raised": "#ffffff", "ink": "#2a2119", "ink-muted": "#6b5d4f",
      "border": "#e6dccd", "border-strong": "#8c7c6a", "saffron": "#e8891c", "saffron-soft": "#fbe6c8",
      "saffron-strong": "#b9640c", "on-saffron-strong": "#ffffff", "terracotta": "#a8481f", "sage": "#4f6b40",
      "danger": "#b3261e", "focus-ring": "#a8481f", "on-saffron": "#2a2119", "on-danger": "#fbf7f0"
    },
    "dark": {
      "surface": "#1c1814", "surface-raised": "#26211c", "ink": "#f4ede3", "ink-muted": "#b5a795",
      "border": "#3a332b", "border-strong": "#85776a", "saffron": "#f0a040", "saffron-soft": "#4a3520",
      "saffron-strong": "#f0a040", "on-saffron-strong": "#1c1814", "terracotta": "#e8845c", "sage": "#9bb584",
      "danger": "#f2877c", "focus-ring": "#f0a040", "on-saffron": "#1c1814", "on-danger": "#1c1814"
    }
  },
  "space": { "s2": 8, "s4": 16, "s6": 24, "s8": 32 },
  "radius": { "sm": 6, "md": 10, "lg": 16 },
  "type": {
    "display": { "size": 40, "lineHeight": 44, "weight": 600 },
    "title": { "size": 28, "lineHeight": 34, "weight": 600 },
    "heading": { "size": 20, "lineHeight": 28, "weight": 600 },
    "body": { "size": 16, "lineHeight": 24, "weight": 400 },
    "body-sm": { "size": 14, "lineHeight": 20, "weight": 400 },
    "label": { "size": 13, "lineHeight": 18, "weight": 500 },
    "code": { "size": 13, "lineHeight": 20, "weight": 400 }
  },
  "icons": {
    "search": { "lucide": "Search", "cupertino": "search" },
    "close": { "lucide": "X", "cupertino": "xmark" },
    "menu": { "lucide": "Menu", "cupertino": "bars" },
    "more": { "lucide": "Ellipsis", "cupertino": "ellipsis" },
    "add": { "lucide": "Plus", "cupertino": "add" },
    "back": { "lucide": "ChevronLeft", "cupertino": "back" },
    "settings": { "lucide": "Settings", "cupertino": "settings" },
    "filter": { "lucide": "SlidersHorizontal", "cupertino": "slider_horizontal_3" },
    "share": { "lucide": "Share", "cupertino": "share" },
    "edit": { "lucide": "Pencil", "cupertino": "pencil" },
    "delete": { "lucide": "Trash2", "cupertino": "delete" },
    "notifications": { "lucide": "Bell", "cupertino": "bell" },
    "chevronDown": { "lucide": "ChevronDown", "cupertino": "chevron_down" },
    "check": { "lucide": "Check", "cupertino": "checkmark" }
  }
}
