{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kashi-example-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ENVIRONMENT": "development", "WEB_ORIGIN": "http://localhost:5173" },
  "d1_databases": [{ "binding": "DB", "database_name": "kashi-example", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
